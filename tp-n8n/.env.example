# Copier ce fichier en .env puis remplacer les valeurs.
# Le fichier .env ne doit jamais être versionné.

# --- PostgreSQL ---
POSTGRES_DB=n8n
POSTGRES_USER=n8n
POSTGRES_PASSWORD=a_remplacer_par_un_mot_de_passe_fort

# --- n8n ---
N8N_HOST=n8n.labo.local
N8N_PROTOCOL=https
N8N_SECURE_COOKIE=true
N8N_WEBHOOK_URL=https://n8n.labo.local/
N8N_GENERIC_TIMEZONE=Europe/Paris
